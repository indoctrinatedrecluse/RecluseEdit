<Window x:Class="RecluseEdit.Extensions.Remote.UI.SshSessionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH Connection Profile" Height="420" Width="440"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="#CCCCCC"
        ResizeMode="NoResize" ShowInTaskbar="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="⚙️ Configure SSH Profile" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,12" />

        <StackPanel Grid.Row="1" VerticalAlignment="Top">
            <!-- Name & Group -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Profile Name:" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,3" />
                    <TextBox x:Name="TxtName" Background="#2D2D2D" Foreground="#FFFFFF" BorderBrush="#3E3E3E" Padding="6,4" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Group / Folder:" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,3" />
                    <TextBox x:Name="TxtGroup" Background="#2D2D2D" Foreground="#FFFFFF" BorderBrush="#3E3E3E" Padding="6,4" Text="Default" />
                </StackPanel>
            </Grid>

            <!-- Host & Port -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Host (IP or Domain):" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,3" />
                    <TextBox x:Name="TxtHost" Background="#2D2D2D" Foreground="#FFFFFF" BorderBrush="#3E3E3E" Padding="6,4" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Port:" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,3" />
                    <TextBox x:Name="TxtPort" Background="#2D2D2D" Foreground="#FFFFFF" BorderBrush="#3E3E3E" Padding="6,4" Text="22" />
                </StackPanel>
            </Grid>

            <!-- Username -->
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="Username:" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,3" />
                <TextBox x:Name="TxtUsername" Background="#2D2D2D" Foreground="#FFFFFF" BorderBrush="#3E3E3E" Padding="6,4" Text="root" />
            </StackPanel>

            <!-- Auth Type Radio Buttons -->
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="Authentication Type:" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RbPassword" Content="Password" Foreground="#CCCCCC" IsChecked="True" Margin="0,0,16,0" Checked="OnAuthTypeChanged" />
                    <RadioButton x:Name="RbPrivateKey" Content="Private Key File" Foreground="#CCCCCC" Checked="OnAuthTypeChanged" />
                </StackPanel>
            </StackPanel>

            <!-- Password Field -->
            <StackPanel x:Name="PanelPassword" Margin="0,0,0,8">
                <TextBlock Text="Password:" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,3" />
                <PasswordBox x:Name="TxtPassword" Background="#2D2D2D" Foreground="#FFFFFF" BorderBrush="#3E3E3E" Padding="6,4" />
            </StackPanel>

            <!-- Private Key Field -->
            <StackPanel x:Name="PanelPrivateKey" Visibility="Collapsed" Margin="0,0,0,8">
                <TextBlock Text="Private Key File (.pem, .id_rsa):" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,3" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtPrivateKeyPath" Grid.Column="0" Background="#2D2D2D" Foreground="#FFFFFF" BorderBrush="#3E3E3E" Padding="6,4" />
                    <Button Grid.Column="2" Content="Browse..." Background="#3E3E3E" Foreground="#FFFFFF" Padding="8,4" Click="OnBrowsePrivateKeyClick" />
                </Grid>
            </StackPanel>
        </StackPanel>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save Profile" Background="#0E639C" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="14,6" Margin="0,0,8,0" Click="OnSaveClick" />
            <Button Content="Cancel" Background="#3E3E3E" Foreground="#CCCCCC" Padding="12,6" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>

