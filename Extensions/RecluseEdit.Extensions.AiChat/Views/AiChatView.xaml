<UserControl x:Class="RecluseEdit.Extensions.AiChat.Views.AiChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="360">

    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#1E1E1E" />
        <SolidColorBrush x:Key="HeaderBg" Color="#252526" />
        <SolidColorBrush x:Key="SectionBg" Color="#2D2D30" />
        <SolidColorBrush x:Key="UserBubbleBg" Color="#0E639C" />
        <SolidColorBrush x:Key="AssistantBubbleBg" Color="#252526" />
        <SolidColorBrush x:Key="ToolBubbleBg" Color="#1E2A38" />
        <SolidColorBrush x:Key="BorderBrushColor" Color="#3E3E42" />
        <SolidColorBrush x:Key="TextPrimary" Color="#D4D4D4" />
        <SolidColorBrush x:Key="TextSecondary" Color="#9DA5B4" />
        <SolidColorBrush x:Key="AccentColor" Color="#007ACC" />
        <SolidColorBrush x:Key="ButtonHover" Color="#3E3E42" />

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource ButtonHover}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource PanelBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0. Sub-Header Toolbar with Model Picker -->
            <RowDefinition Height="Auto" /> <!-- 1. Inline Authentication Banner -->
            <RowDefinition Height="Auto" /> <!-- 2. Advanced Settings Drawer (Collapsible) -->
            <RowDefinition Height="*" />    <!-- 3. Message History -->
            <RowDefinition Height="Auto" /> <!-- 4. Status Bar -->
            <RowDefinition Height="Auto" /> <!-- 5. Prompt Input Area -->
        </Grid.RowDefinitions>

        <!-- 0. Sub-Header Toolbar with Direct Model & Auth in Chat -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBg}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,0,0,1" Padding="6,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Model Selector right in chat header -->
                <ComboBox x:Name="CmbHeaderModel" 
                          Grid.Column="0"
                          VerticalAlignment="Center"
                          Margin="0,0,4,0"
                          Background="#1E1E1E" 
                          Foreground="{StaticResource TextPrimary}" 
                          BorderBrush="{StaticResource BorderBrushColor}" 
                          Padding="4,2" 
                          FontSize="11" 
                          SelectionChanged="OnHeaderModelSelectionChanged"
                          ToolTip="Switch AI Model &amp; Provider" />

                <!-- Auth status badge / action button -->
                <Button x:Name="BtnHeaderAuth" 
                        Grid.Column="1" 
                        Style="{StaticResource IconButtonStyle}" 
                        Margin="2,0" 
                        Click="OnToggleInlineAuthClick" 
                        ToolTip="Configure API Key or Token for this model">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtHeaderAuthIcon" Text="🔑" FontSize="11" Margin="0,0,2,0" />
                        <TextBlock x:Name="TxtHeaderAuthLabel" Text="Key Set" FontSize="10" Foreground="#89D185" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" ToolTip="Clear Conversation" Click="OnClearChatClick">
                    <TextBlock Text="🗑️" FontSize="11" />
                </Button>

                <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" ToolTip="Advanced Settings &amp; Endpoints" Click="OnToggleSettingsClick">
                    <TextBlock Text="⚙️" FontSize="11" />
                </Button>
            </Grid>
        </Border>

        <!-- 1. Inline Authentication Banner (Visible directly in Chat when key needed or requested) -->
        <Border x:Name="InlineAuthBanner" Grid.Row="1" Background="#263238" BorderBrush="#007ACC" BorderThickness="0,0,0,1" Padding="10,8" Visibility="Collapsed">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtInlineAuthTitle" Text="🔑 Enter Credentials for DeepSeek" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" FontSize="11" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Padding="3,1" Click="OnCloseInlineAuthClick" ToolTip="Close Auth Banner">
                        <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                    </Button>
                </Grid>

                <Grid Margin="0,0,0,6">
                    <PasswordBox x:Name="TxtInlineApiKey" Background="#1E1E1E" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderBrushColor}" Padding="4,3" FontSize="11" KeyDown="OnInlineKeyKeyDown" />
                    <TextBox x:Name="TxtInlineApiKeyVisible" Background="#1E1E1E" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderBrushColor}" Padding="4,3" FontSize="11" Visibility="Collapsed" KeyDown="OnInlineKeyKeyDown" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="ChkInlineShowKey" Content="Show" Foreground="{StaticResource TextSecondary}" FontSize="10" Checked="OnToggleInlineShowKey" Unchecked="OnToggleInlineShowKey" VerticalAlignment="Center" />

                    <Button x:Name="BtnInlineAutoDetect" Grid.Column="2" Margin="4,0" Padding="8,3" Background="#3E3E42" Foreground="{StaticResource TextPrimary}" BorderThickness="0" FontSize="11" Cursor="Hand" Click="OnInlineAutoDetectClick" ToolTip="Detect credentials automatically from environment variables or CLI">
                        <TextBlock Text="🔍 Auto-Detect" />
                    </Button>

                    <Button Grid.Column="3" Padding="10,3" Background="{StaticResource AccentColor}" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Click="OnSaveInlineAuthClick">
                        <TextBlock Text="Save &amp; Use" />
                    </Button>
                </Grid>

                <TextBlock x:Name="TxtInlineStatus" Text="" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- 2. Advanced Settings Drawer (Collapsible) -->
        <Border x:Name="SettingsDrawer" Grid.Row="2" Background="{StaticResource SectionBg}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,0,0,1" Padding="10" Visibility="Collapsed">
            <StackPanel>
                <!-- Provider Selector -->
                <TextBlock Text="AI Provider:" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,3" />
                <ComboBox x:Name="CmbProvider" Background="#1E1E1E" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderBrushColor}" Padding="4,3" FontSize="11" Margin="0,0,0,8" SelectionChanged="OnProviderSelectionChanged" />

                <!-- Auth Mode & Discovery -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Authentication Mode:" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,3" />
                        <ComboBox x:Name="CmbAuthMode" Background="#1E1E1E" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderBrushColor}" Padding="4,3" FontSize="11" SelectionChanged="OnAuthModeSelectionChanged" />
                    </StackPanel>
                    <Button x:Name="BtnDrawerAutoDetect" Grid.Column="1" VerticalAlignment="Bottom" Margin="8,0,0,0" Padding="8,4" Background="#3E3E42" Foreground="{StaticResource TextPrimary}" BorderThickness="0" FontSize="11" Cursor="Hand" Click="OnDrawerAutoDetectClick" ToolTip="Detect credentials from environment variables or gcloud CLI">
                        <TextBlock Text="🔍 Auto-Detect" />
                    </Button>
                </Grid>

                <!-- Endpoint URL -->
                <TextBlock Text="API Endpoint URL:" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,3" />
                <TextBox x:Name="TxtApiEndpoint" Background="#1E1E1E" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderBrushColor}" Padding="4,3" FontSize="11" Margin="0,0,0,8" />

                <!-- API Key / Token -->
                <TextBlock x:Name="LblSecretKey" Text="API Key / Access Token:" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,3" />
                <Grid Margin="0,0,0,8">
                    <PasswordBox x:Name="TxtApiKey" Background="#1E1E1E" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderBrushColor}" Padding="4,3" FontSize="11" />
                    <TextBox x:Name="TxtApiKeyVisible" Background="#1E1E1E" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderBrushColor}" Padding="4,3" FontSize="11" Visibility="Collapsed" />
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="ChkShowKey" Content="Show Key" Foreground="{StaticResource TextSecondary}" FontSize="10" Checked="OnToggleShowKey" Unchecked="OnToggleShowKey" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="Model: " Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center" />
                        <ComboBox x:Name="CmbModel" Width="140" IsEditable="True" Background="#1E1E1E" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderBrushColor}" Padding="3,2" FontSize="11" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                    <Button Content="Save &amp; Close" Background="{StaticResource AccentColor}" Foreground="White" BorderThickness="0" Padding="10,4" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Click="OnSaveSettingsClick" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 3. Message History -->
        <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,8">
            <StackPanel x:Name="MessagePanel">
                <!-- Welcome placeholder if empty -->
                <Border x:Name="WelcomeBorder" Background="{StaticResource SectionBg}" CornerRadius="6" Padding="14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="🤖 AI Chat Hub" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="13" Margin="0,0,0,6" />
                        <TextBlock Text="Multi-model AI assistant supporting DeepSeek (default), OpenAI GPT-4o, Google Gemini &amp; Antigravity, Anthropic Claude, and Local Ollama." TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,6" />
                        <TextBlock Text="• Switch models directly via the dropdown above" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="8,0,0,2" />
                        <TextBlock Text="• Read &amp; write workspace files with full context" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="8,0,0,2" />
                        <TextBlock Text="• Execute shell commands with user approval" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="8,0,0,2" />
                        <TextBlock Text="• Press Ctrl+Shift+R for instant AI Code Review" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="8,0,0,2" />
                        <TextBlock Text="• Press Ctrl+I for floating in-editor generation" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="8,0,0,8" />
                        <TextBlock x:Name="TxtWelcomeAuthHint" Text="Active model: DeepSeek (deepseek-chat)." Foreground="{StaticResource AccentColor}" FontSize="11" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 4. Status Bar -->
        <Border Grid.Row="4" Background="{StaticResource HeaderBg}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,1,0,0" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatusIndicator" Text="Idle" Foreground="{StaticResource TextSecondary}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock x:Name="TxtActiveFileBadge" Text="📄 No file" Foreground="{StaticResource TextSecondary}" FontSize="10" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="BtnStopGeneration" Grid.Column="1" Style="{StaticResource IconButtonStyle}" Visibility="Collapsed" Click="OnStopGenerationClick" ToolTip="Stop Generation">
                    <TextBlock Text="⏹ Stop" Foreground="#F44336" FontWeight="SemiBold" FontSize="10" />
                </Button>
            </Grid>
        </Border>

        <!-- 5. Prompt Input Area -->
        <Border Grid.Row="5" Background="{StaticResource HeaderBg}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,1,0,0" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox x:Name="TxtPromptInput" 
                         Grid.Row="0"
                         Background="#1E1E1E" 
                         Foreground="{StaticResource TextPrimary}" 
                         BorderBrush="{StaticResource BorderBrushColor}" 
                         Padding="6" 
                         FontSize="12" 
                         MinHeight="55" 
                         MaxHeight="140"
                         TextWrapping="Wrap" 
                         AcceptsReturn="True" 
                         VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="OnPromptInputPreviewKeyDown" />

                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="ChkIncludeActiveFile" 
                              Content="Attach active file context" 
                              IsChecked="True" 
                              Foreground="{StaticResource TextSecondary}" 
                              FontSize="11" 
                              VerticalAlignment="Center" />

                    <Button x:Name="BtnSendPrompt" 
                            Grid.Column="1" 
                            Background="{StaticResource AccentColor}" 
                            Foreground="White" 
                            BorderThickness="0" 
                            Padding="12,5" 
                            FontSize="11" 
                            FontWeight="SemiBold" 
                            Cursor="Hand" 
                            Click="OnSendPromptClick">
                        <TextBlock Text="Send 🚀" />
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
