<UserControl x:Class="RecluseEdit.Extensions.RestClient.UI.RestClientPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="380"
             Background="#1E1E1E" Foreground="#D4D4D4">

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Request Bar (Method + URL + Send) -->
            <RowDefinition Height="150" MinHeight="80" /> <!-- Request Details (Headers + Body) -->
            <RowDefinition Height="Auto" /> <!-- Status & Metrics Header -->
            <RowDefinition Height="*" MinHeight="150" /> <!-- Response Tabs -->
        </Grid.RowDefinitions>

        <!-- 1. Request Bar -->
        <Border Grid.Row="0" Background="#252526" Padding="6" CornerRadius="4" Margin="0,0,0,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Method Selector -->
                <ComboBox x:Name="ComboMethod" Grid.Row="0" Grid.Column="0"
                          Background="#2D2D2D" Foreground="#D4D4D4"
                          BorderBrush="#3F3F46" Padding="6,4" Margin="0,0,4,4"
                          FontWeight="Bold">
                    <ComboBoxItem Content="GET" IsSelected="True" Foreground="#569CD6" />
                    <ComboBoxItem Content="POST" Foreground="#4EC9B0" />
                    <ComboBoxItem Content="PUT" Foreground="#DCDCAA" />
                    <ComboBoxItem Content="PATCH" Foreground="#CE9178" />
                    <ComboBoxItem Content="DELETE" Foreground="#F48771" />
                    <ComboBoxItem Content="HEAD" Foreground="#9CDCFE" />
                    <ComboBoxItem Content="OPTIONS" Foreground="#808080" />
                </ComboBox>

                <!-- URL Bar -->
                <TextBox x:Name="TxtUrl" Grid.Row="0" Grid.Column="1"
                         Text="https://api.github.com/zen"
                         Background="#1E1E1E" Foreground="#D4D4D4" CaretBrush="#D4D4D4"
                         BorderBrush="#3F3F46" Padding="6,4" Margin="0,0,0,4"
                         FontFamily="Consolas, Courier New" FontSize="12"
                         VerticalContentAlignment="Center" KeyDown="OnUrlKeyDown" />

                <!-- Send Button -->
                <Button x:Name="BtnSend" Grid.Row="1" Grid.ColumnSpan="2"
                        Content="⚡ Send Request (Ctrl+Enter)"
                        Background="#007ACC" Foreground="White" BorderThickness="0"
                        Padding="8,5" FontWeight="SemiBold" Cursor="Hand"
                        Click="OnSendClick" />
            </Grid>
        </Border>

        <!-- 2. Request Details (Headers & Payload) -->
        <TabControl Grid.Row="1" Background="#252526" BorderBrush="#3F3F46" Margin="0,0,0,6">
            <TabItem Header="Headers" Background="#252526" Foreground="#D4D4D4">
                <TextBox x:Name="TxtRequestHeaders"
                         Text="User-Agent: RecluseEdit-RestClient/1.0&#x0a;Accept: application/json"
                         Background="#1E1E1E" Foreground="#D4D4D4" CaretBrush="#D4D4D4"
                         BorderThickness="0" AcceptsReturn="True" AcceptsTab="True"
                         FontFamily="Consolas, Courier New" FontSize="11"
                         Padding="4" VerticalScrollBarVisibility="Auto" />
            </TabItem>
            <TabItem Header="Body" Background="#252526" Foreground="#D4D4D4">
                <TextBox x:Name="TxtRequestBody"
                         Background="#1E1E1E" Foreground="#D4D4D4" CaretBrush="#D4D4D4"
                         BorderThickness="0" AcceptsReturn="True" AcceptsTab="True"
                         FontFamily="Consolas, Courier New" FontSize="11"
                         Padding="4" VerticalScrollBarVisibility="Auto" />
            </TabItem>
            <TabItem Header="Raw (.http)" Background="#252526" Foreground="#D4D4D4">
                <TextBox x:Name="TxtRawHttp"
                         Text="GET https://api.github.com/zen&#x0a;User-Agent: RecluseEdit"
                         Background="#1E1E1E" Foreground="#D4D4D4" CaretBrush="#D4D4D4"
                         BorderThickness="0" AcceptsReturn="True" AcceptsTab="True"
                         FontFamily="Consolas, Courier New" FontSize="11"
                         Padding="4" VerticalScrollBarVisibility="Auto" />
            </TabItem>
        </TabControl>

        <!-- 3. Status and Metrics Bar -->
        <Border Grid.Row="2" Background="#252526" Padding="6,4" CornerRadius="3" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status Badge -->
                <Border x:Name="BadgeStatus" Grid.Column="0" Background="#333333" CornerRadius="2" Padding="6,2" Margin="0,0,6,0">
                    <TextBlock x:Name="TxtStatusCode" Text="Ready" Foreground="#808080" FontWeight="Bold" FontSize="11" />
                </Border>

                <!-- Elapsed Time Badge -->
                <Border Grid.Column="1" Background="#2D2D2D" CornerRadius="2" Padding="6,2" Margin="0,0,6,0">
                    <TextBlock x:Name="TxtElapsed" Text="-- ms" Foreground="#DCDCAA" FontSize="11" />
                </Border>

                <!-- Content Size Badge -->
                <Border Grid.Column="2" Background="#2D2D2D" CornerRadius="2" Padding="6,2">
                    <TextBlock x:Name="TxtSize" Text="-- B" Foreground="#4EC9B0" FontSize="11" />
                </Border>

                <!-- Copy Response Button -->
                <Button x:Name="BtnCopyResponse" Grid.Column="4" Content="📋 Copy" Background="Transparent" Foreground="#9CDCFE" BorderThickness="0" Cursor="Hand" Padding="4,2" Click="OnCopyResponseClick" />
            </Grid>
        </Border>

        <!-- 4. Response Tabs -->
        <TabControl Grid.Row="3" Background="#252526" BorderBrush="#3F3F46">
            <TabItem Header="Response Body" Background="#252526" Foreground="#D4D4D4">
                <TextBox x:Name="TxtResponseBody"
                         IsReadOnly="True"
                         Background="#1E1E1E" Foreground="#D4D4D4" CaretBrush="#D4D4D4"
                         BorderThickness="0" TextWrapping="Wrap"
                         AcceptsReturn="True"
                         FontFamily="Consolas, Courier New" FontSize="12"
                         Padding="6" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />
            </TabItem>
            <TabItem Header="Response Headers" Background="#252526" Foreground="#D4D4D4">
                <TextBox x:Name="TxtResponseHeaders"
                         IsReadOnly="True"
                         Background="#1E1E1E" Foreground="#9CDCFE"
                         BorderThickness="0" TextWrapping="Wrap"
                         FontFamily="Consolas, Courier New" FontSize="11"
                         Padding="6" VerticalScrollBarVisibility="Auto" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
