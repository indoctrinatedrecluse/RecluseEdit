<UserControl x:Class="RecluseEdit.Extensions.RestClient.UI.MockServerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="380"
             Background="#1E1E1E" Foreground="#D4D4D4">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0. Server Controls Header -->
            <RowDefinition Height="*" />    <!-- 1. Tabs: Routes & Logs -->
            <RowDefinition Height="Auto" /> <!-- 2. Footer Info -->
        </Grid.RowDefinitions>

        <!-- 0. Server Controls Header -->
        <Border Grid.Row="0" Background="#252526" Padding="8,6" CornerRadius="4" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="65" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Port:" Foreground="#808080" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="TxtPort" Grid.Row="0" Grid.Column="1" Text="5050"
                         Background="#1E1E1E" Foreground="#9CDCFE" CaretBrush="#D4D4D4"
                         BorderBrush="#3F3F46" Padding="4,2" FontSize="11" HorizontalContentAlignment="Center" />
                
                <Button x:Name="BtnToggleServer" Grid.Row="0" Grid.Column="2" Content="▶ Start Server"
                        Background="#007ACC" Foreground="White" BorderThickness="0"
                        Padding="10,4" FontWeight="SemiBold" FontSize="11" Margin="6,0,0,0"
                        Cursor="Hand" Click="OnToggleServerClick" />

                <!-- Status Text & Address -->
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock x:Name="TxtServerStatus" Text="⚪ Server Stopped" Foreground="#808080" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
                    <TextBlock Text=" • " Foreground="#505050" />
                    <TextBlock x:Name="TxtBaseUrl" Text="http://localhost:5050" Foreground="#4EC9B0" FontSize="11" Cursor="Hand" ToolTip="Click to copy base URL" MouseLeftButtonDown="OnCopyBaseUrlClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. Tabs: Endpoints & Traffic Logs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderBrush="#3F3F46">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="#252526" />
                    <Setter Property="Foreground" Value="#D4D4D4" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Padding" Value="10,4" />
                </Style>
            </TabControl.Resources>

            <!-- Tab A: Endpoints -->
            <TabItem Header="🌐 Endpoints">
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="120" MinHeight="60" /> <!-- Route List -->
                        <RowDefinition Height="Auto" />                 <!-- Add/Remove Buttons -->
                        <RowDefinition Height="*" MinHeight="140" />   <!-- Route Editor Form -->
                    </Grid.RowDefinitions>

                    <!-- Route List Box -->
                    <ListBox x:Name="ListRoutes" Grid.Row="0"
                             Background="#1E1E1E" BorderBrush="#3F3F46" Foreground="#D4D4D4"
                             SelectionChanged="OnRouteSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="55" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Method}" FontWeight="Bold" Foreground="#569CD6" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Path}" Foreground="#DCDCAA" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding StatusCode}" Foreground="#4EC9B0" FontSize="11" VerticalAlignment="Center" Margin="4,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Route Toolbar -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,4">
                        <Button x:Name="BtnAddRoute" Content="+ Add Route" Background="#333333" Foreground="#D4D4D4" BorderThickness="0" Padding="8,3" FontSize="11" Margin="0,0,4,0" Cursor="Hand" Click="OnAddRouteClick" />
                        <Button x:Name="BtnDeleteRoute" Content="- Delete" Background="#333333" Foreground="#D4D4D4" BorderThickness="0" Padding="8,3" FontSize="11" Cursor="Hand" Click="OnDeleteRouteClick" />
                    </StackPanel>

                    <!-- Route Details Editor -->
                    <Border Grid.Row="2" Background="#252526" Padding="6" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /> <!-- Method & Path -->
                                <RowDefinition Height="Auto" /> <!-- Status & Latency -->
                                <RowDefinition Height="*" />    <!-- Response Body -->
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="75" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="ComboMethod" Grid.Column="0" Background="#2D2D2D" Foreground="#D4D4D4" FontSize="11" SelectionChanged="OnRouteFieldChanged">
                                    <ComboBoxItem Content="GET" IsSelected="True" />
                                    <ComboBoxItem Content="POST" />
                                    <ComboBoxItem Content="PUT" />
                                    <ComboBoxItem Content="DELETE" />
                                    <ComboBoxItem Content="PATCH" />
                                </ComboBox>
                                <TextBox x:Name="TxtRoutePath" Grid.Column="1" Text="/api/test"
                                         Background="#1E1E1E" Foreground="#D4D4D4" CaretBrush="#D4D4D4"
                                         BorderBrush="#3F3F46" Padding="4,2" FontSize="11" Margin="4,0,0,0"
                                         TextChanged="OnRouteFieldChanged" />
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Status:" Foreground="#808080" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox x:Name="TxtStatusCode" Grid.Column="1" Text="200"
                                         Background="#1E1E1E" Foreground="#4EC9B0" CaretBrush="#D4D4D4"
                                         BorderBrush="#3F3F46" Padding="3,1" FontSize="11" HorizontalContentAlignment="Center"
                                         TextChanged="OnRouteFieldChanged" />

                                <TextBlock Grid.Column="2" Text="Latency:" Foreground="#808080" FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0" />
                                <Slider x:Name="SliderLatency" Grid.Column="3" Minimum="0" Maximum="2000" Value="100" SmallChange="50" LargeChange="200" VerticalAlignment="Center" ValueChanged="OnRouteFieldChanged" />
                                <TextBlock x:Name="TxtLatencyVal" Grid.Column="4" Text="100ms" Foreground="#9CDCFE" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </Grid>

                            <!-- Response Body -->
                            <TextBox x:Name="TxtResponseBody" Grid.Row="2"
                                     Background="#1E1E1E" Foreground="#9CDCFE" CaretBrush="#D4D4D4"
                                     BorderBrush="#3F3F46" Padding="4" FontFamily="Consolas, Courier New" FontSize="11"
                                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     TextChanged="OnRouteFieldChanged" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab B: Traffic Logs -->
            <TabItem Header="📊 Traffic Logs">
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="GridTrafficLogs" Grid.Row="0"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              Background="#1E1E1E" Foreground="#D4D4D4" RowBackground="#252526" AlternatingRowBackground="#1E1E1E"
                              GridLinesVisibility="None" BorderBrush="#3F3F46" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding FormattedTime}" Width="70" />
                            <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="55" />
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" />
                            <DataGridTextColumn Header="Code" Binding="{Binding StatusCode}" Width="45" />
                            <DataGridTextColumn Header="Latency" Binding="{Binding FormattedDuration}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button x:Name="BtnClearLogs" Grid.Row="1" Content="🗑️ Clear Logs"
                            Background="#333333" Foreground="#D4D4D4" BorderThickness="0"
                            Padding="8,3" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Right"
                            Cursor="Hand" Click="OnClearLogsClick" />
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 2. Footer Info -->
        <Border Grid.Row="2" Background="#252526" Padding="6,4" CornerRadius="3" Margin="0,6,0,0">
            <TextBlock Text="CORS is enabled (*). Local web apps can fetch freely." FontSize="10" Foreground="#808080" />
        </Border>
    </Grid>
</UserControl>

