## Visual Studio / .NET .gitignore

# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio files
.vs/
*.user
*.userosscache
*.sln.docstates
*.suo

# Temporary files
*.tmp
*.bak
*.swp
*~

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# Code signing & certificates (exclude private keys, allow public Root CA)
*.pfx
*.p12
*.key
*.pem
!certs/*.cer

# Packaging artifacts
package/
RecluseEdit-windows-*.zip

