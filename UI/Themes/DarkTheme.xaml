<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme Brushes -->
    <SolidColorBrush x:Key="BgPrimary" Color="#1E1E1E" />
    <SolidColorBrush x:Key="BgSecondary" Color="#252526" />
    <SolidColorBrush x:Key="BgTertiary" Color="#2D2D30" />
    <SolidColorBrush x:Key="BgHover" Color="#3E3E42" />
    <SolidColorBrush x:Key="BgActive" Color="#007ACC" />
    <SolidColorBrush x:Key="FgPrimary" Color="#D4D4D4" />
    <SolidColorBrush x:Key="FgSecondary" Color="#969696" />
    <SolidColorBrush x:Key="FgMuted" Color="#6E6E6E" />
    <SolidColorBrush x:Key="FgAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderDark" Color="#333337" />
    <SolidColorBrush x:Key="BorderLight" Color="#3F3F46" />
    <SolidColorBrush x:Key="AccentBlue" Color="#007ACC" />
    <SolidColorBrush x:Key="AccentBlueHover" Color="#1C97EA" />
    <SolidColorBrush x:Key="GutterBg" Color="#1E1E1E" />
    <SolidColorBrush x:Key="LineNumberFg" Color="#858585" />

    <!-- ToolBar / Button Style -->
    <Style x:Key="ToolbarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource FgPrimary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="2,1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BgHover}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentBlue}" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tab Close Button Style -->
    <Style x:Key="TabCloseButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource FgSecondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontFamily" Value="Segoe UI, Arial" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="2">
                        <TextBlock Text="✕" 
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   Margin="0,-1,0,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#C42B1C" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menu Styles -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="{DynamicResource BgTertiary}" />
        <Setter Property="Foreground" Value="{DynamicResource FgPrimary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Background" Value="{DynamicResource BgTertiary}" />
        <Setter Property="Foreground" Value="{DynamicResource FgPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="7,4" />
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource BgHover}" />
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter Property="Background" Value="{DynamicResource BgHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ComboBox Style for Language Selector -->
    <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource BgTertiary}" />
        <Setter Property="Foreground" Value="{DynamicResource FgPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDark}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="6,3" />
    </Style>

    <!-- ContextMenu Styles -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource BgTertiary}" />
        <Setter Property="Foreground" Value="{DynamicResource FgPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDark}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="2" />
    </Style>

    <!-- GridSplitter Style -->
    <Style x:Key="VerticalSplitterStyle" TargetType="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource BorderDark}" />
        <Setter Property="Width" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentBlue}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Horizontal GridSplitter Style -->
    <Style x:Key="HorizontalSplitterStyle" TargetType="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource BorderDark}" />
        <Setter Property="Height" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="SizeNS" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentBlue}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- TreeView Styles -->
    <Style TargetType="TreeView">
        <Setter Property="Background" Value="{DynamicResource BgSecondary}" />
        <Setter Property="Foreground" Value="{DynamicResource FgPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{DynamicResource FgPrimary}" />
        <Setter Property="Padding" Value="3,2" />
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>

