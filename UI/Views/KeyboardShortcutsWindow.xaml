<Window x:Class="RecluseEdit.UI.Views.KeyboardShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Keyboard Shortcuts Reference - RecluseEdit"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="650" Width="820"
        MinHeight="400" MinWidth="550"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgPrimary}"
        Foreground="{StaticResource FgPrimary}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Search Filter -->
            <RowDefinition Height="*" />    <!-- Shortcuts List -->
            <RowDefinition Height="Auto" /> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- 0. Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="⌨️ Keyboard Shortcuts Reference" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource FgAccent}" />
            <TextBlock Text="Quick reference for editor navigation, multiline column edits, and commands." FontSize="12" Foreground="{StaticResource FgSecondary}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- 1. Search Filter -->
        <Border Grid.Row="1" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,0,12">
            <Grid>
                <TextBox x:Name="TxtFilter"
                         Background="Transparent"
                         Foreground="{StaticResource FgPrimary}"
                         CaretBrush="{StaticResource AccentBlue}"
                         BorderThickness="0"
                         FontSize="13"
                         TextChanged="OnFilterTextChanged" />
                <TextBlock x:Name="TxtPlaceholder"
                           Text="🔍 Filter shortcuts by command, category, or keys (e.g. comment, line, ctrl)..."
                           Foreground="{StaticResource FgSecondary}"
                           FontSize="12"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0" />
            </Grid>
        </Border>

        <!-- 2. Shortcuts DataGrid / Items -->
        <Border Grid.Row="2" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ItemsShortcuts">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#2D2D2D" BorderThickness="0,0,0,1" Padding="8,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" /> <!-- Category -->
                                        <ColumnDefinition Width="*" />   <!-- Command Name -->
                                        <ColumnDefinition Width="220" /> <!-- Key Badge -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Category -->
                                    <TextBlock Grid.Column="0" 
                                               Text="{Binding Category}" 
                                               Foreground="#4EC9B0" 
                                               FontSize="12" 
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />

                                    <!-- Description -->
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding Name}" 
                                               Foreground="#D4D4D4" 
                                               FontSize="13" 
                                               VerticalAlignment="Center" />

                                    <!-- Keycap Badge -->
                                    <Border Grid.Column="2" 
                                            HorizontalAlignment="Right"
                                            Background="#1E1E1E" 
                                            BorderBrush="#3E3E42" 
                                            BorderThickness="1" 
                                            CornerRadius="4" 
                                            Padding="8,3" 
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Shortcut}" 
                                                   Foreground="#007ACC" 
                                                   FontSize="12" 
                                                   FontWeight="SemiBold"
                                                   FontFamily="Consolas, Cascadia Code" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 3. Footer -->
        <Border Grid.Row="3" Margin="0,14,0,0">
            <DockPanel>
                <TextBlock Text="Tip: You can also press Ctrl+Shift+P to search and run any command dynamically." 
                           Foreground="{StaticResource FgSecondary}" 
                           FontSize="11" 
                           VerticalAlignment="Center" />
                <Button Content="Close" 
                        Width="90" 
                        Height="30" 
                        HorizontalAlignment="Right" 
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="OnCloseClick" />
            </DockPanel>
        </Border>
    </Grid>
</Window>

