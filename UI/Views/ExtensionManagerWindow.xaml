<Window x:Class="RecluseEdit.UI.Views.ExtensionManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Extension Manager - RecluseEdit" 
        Height="500" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgPrimary}"
        Foreground="{StaticResource FgPrimary}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Installed Extensions" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource FgAccent}" />
            <TextBlock Text="Manage, inspect, and install modular language and editor plugins." FontSize="12" Foreground="{StaticResource FgSecondary}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Extensions List -->
        <Border Grid.Row="1" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4">
            <ListView x:Name="ListExtensions" Background="Transparent" BorderThickness="0" Foreground="{StaticResource FgPrimary}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12,8" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource FgAccent}" />
                                        <Border Background="{StaticResource BgHover}" CornerRadius="3" Margin="8,0,0,0" Padding="6,1">
                                            <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontSize="11" Foreground="{StaticResource FgSecondary}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource FgPrimary}" Margin="0,4,0,0" TextWrapping="Wrap" />

                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="By " FontSize="11" Foreground="{StaticResource FgMuted}" />
                                        <TextBlock Text="{Binding Author}" FontSize="11" Foreground="{StaticResource FgSecondary}" />
                                        <TextBlock Text=" • ID: " FontSize="11" Foreground="{StaticResource FgMuted}" Margin="6,0,0,0" />
                                        <TextBlock Text="{Binding Id}" FontSize="11" Foreground="{StaticResource FgMuted}" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="1" VerticalAlignment="Center" Background="#1B5E20" CornerRadius="3" Padding="8,3">
                                    <TextBlock Text="Active" FontSize="11" Foreground="#81C784" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Bottom Actions -->
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button Style="{StaticResource ToolbarButtonStyle}" Content="📂 Open Extensions Folder" Padding="10,6" Click="OnOpenFolderClick" />
            <Button Style="{StaticResource ToolbarButtonStyle}" Content="➕ Install Extension (.dll)..." Padding="10,6" Margin="8,0,0,0" Click="OnInstallDllClick" />
            <Button Style="{StaticResource ToolbarButtonStyle}" Content="Close" Padding="16,6" HorizontalAlignment="Right" Click="OnCloseClick" />
        </DockPanel>
    </Grid>
</Window>

