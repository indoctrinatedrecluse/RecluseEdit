<Window x:Class="RecluseEdit.UI.Dialogs.ThemePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Color Theme"
        Width="520" Height="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimary}"
        Foreground="{DynamicResource FgPrimary}"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <Style x:Key="ThemeItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="2,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgActive}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="🎨 Color Themes" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" Foreground="{DynamicResource FgPrimary}" />

        <!-- Search Box -->
        <Border Grid.Row="1" Background="{DynamicResource BgSecondary}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,10">
            <Grid>
                <TextBlock x:Name="TxtSearchPlaceholder" Text="Type to filter themes (use Up/Down to preview)..." Foreground="{DynamicResource FgMuted}" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False" />
                <TextBox x:Name="SearchBox" Background="Transparent" Foreground="{DynamicResource FgPrimary}" BorderThickness="0" FontSize="12" TextChanged="OnSearchTextChanged" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Themes ListBox -->
        <Border Grid.Row="2" Background="{DynamicResource BgSecondary}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="4">
            <ListBox x:Name="ThemesListBox" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ThemeItemStyle}" SelectionChanged="OnThemesSelectionChanged" MouseDoubleClick="OnThemesMouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource FgPrimary}" />
                                    <Border Background="{DynamicResource BorderLight}" CornerRadius="3" Padding="4,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Type}" FontSize="9" Foreground="{DynamicResource FgPrimary}" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource FgSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Color Preview Swatches (4 dots: Background, Accent, Foreground, Border) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,4,0">
                                <Border Width="12" Height="12" CornerRadius="6" Margin="2,0" Background="{Binding Colors.BgPrimary}" BorderBrush="#808080" BorderThickness="1" ToolTip="Background" />
                                <Border Width="12" Height="12" CornerRadius="6" Margin="2,0" Background="{Binding Colors.Accent}" ToolTip="Accent" />
                                <Border Width="12" Height="12" CornerRadius="6" Margin="2,0" Background="{Binding Colors.FgPrimary}" ToolTip="Text Foreground" />
                                <Border Width="12" Height="12" CornerRadius="6" Margin="2,0" Background="{Binding Colors.StatusBarBg}" ToolTip="Status Bar" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Apply" Width="80" Height="28" Margin="0,0,8,0" Background="{DynamicResource AccentBlue}" Foreground="#FFFFFF" BorderThickness="0" Click="OnApplyClick" Cursor="Hand" FontWeight="SemiBold" />
            <Button Content="Cancel" Width="80" Height="28" Background="{DynamicResource BgHover}" Foreground="{DynamicResource FgPrimary}" BorderThickness="1" BorderBrush="{DynamicResource BorderDark}" Click="OnCancelClick" Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>

