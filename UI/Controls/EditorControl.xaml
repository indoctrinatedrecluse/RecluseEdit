<UserControl x:Class="RecluseEdit.UI.Controls.EditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:controls="clr-namespace:RecluseEdit.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#1E1E1E">
        <avalonedit:TextEditor x:Name="Editor"
                               Background="#1E1E1E"
                               Foreground="#D4D4D4"
                               LineNumbersForeground="#858585"
                               ShowLineNumbers="True"
                               FontFamily="Consolas, Cascadia Code, Courier New"
                               FontSize="14"
                               WordWrap="False"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto" />

        <!-- Floating Find & Replace Bar -->
        <controls:FindReplaceControl x:Name="FindReplace"
                                     VerticalAlignment="Top"
                                     HorizontalAlignment="Right"
                                     Margin="0,8,20,0"
                                     Visibility="Collapsed" />
    </Grid>
</UserControl>
