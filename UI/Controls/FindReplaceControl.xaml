<UserControl x:Class="RecluseEdit.UI.Controls.FindReplaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignWidth="400"
             Background="{StaticResource BgSecondary}">
    <Border Background="{StaticResource BgSecondary}" 
            BorderBrush="{StaticResource BorderDark}" 
            BorderThickness="1" 
            CornerRadius="4" 
            Padding="8,6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="3" Opacity="0.4" />
        </Border.Effect>

        <StackPanel>
            <!-- Row 1: Find -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnToggleReplace" 
                        Grid.Column="0" 
                        Style="{StaticResource ToolbarButtonStyle}" 
                        Content="▶" 
                        Width="22" Height="22" 
                        Padding="0" 
                        ToolTip="Toggle Replace" 
                        Click="OnToggleReplaceClick" />

                <TextBox x:Name="TxtFind" 
                         Grid.Column="1" 
                         Background="{StaticResource BgTertiary}" 
                         Foreground="{StaticResource FgPrimary}" 
                         BorderBrush="{StaticResource BorderLight}" 
                         CaretBrush="#FFFFFF"
                         Padding="4,2" 
                         FontSize="12" 
                         VerticalContentAlignment="Center"
                         Margin="4,0"
                         TextChanged="OnFindTextChanged" 
                         KeyDown="OnFindKeyDown" />

                <TextBlock x:Name="TxtMatchCount" 
                           Grid.Column="2" 
                           Foreground="{StaticResource FgSecondary}" 
                           FontSize="11" 
                           VerticalAlignment="Center" 
                           Margin="4,0" 
                           Text="No results" />

                <Primitives:ToggleButton xmlns:Primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                                         x:Name="ToggleMatchCase" 
                                         Grid.Column="3" 
                                         Content="Aa" 
                                         ToolTip="Match Case" 
                                         Padding="5,1" Margin="2,0" 
                                         FontSize="11" 
                                         Click="OnOptionChanged" />

                <Button Grid.Column="4" 
                        Style="{StaticResource ToolbarButtonStyle}" 
                        Content="▲" 
                        Width="22" Height="22" 
                        Padding="0" 
                        ToolTip="Previous Match (Shift+Enter)" 
                        Click="OnPrevMatchClick" />

                <Button Grid.Column="5" 
                        Style="{StaticResource ToolbarButtonStyle}" 
                        Content="▼" 
                        Width="22" Height="22" 
                        Padding="0" 
                        ToolTip="Next Match (Enter)" 
                        Click="OnNextMatchClick" />

                <Button Grid.Column="6" 
                        Style="{StaticResource TabCloseButtonStyle}" 
                        Margin="4,0,0,0" 
                        ToolTip="Close (Esc)" 
                        Click="OnCloseClick" />
            </Grid>

            <!-- Row 2: Replace (Toggleable) -->
            <Grid x:Name="ReplaceRow" Visibility="Collapsed" Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtReplace" 
                         Grid.Column="1" 
                         Background="{StaticResource BgTertiary}" 
                         Foreground="{StaticResource FgPrimary}" 
                         BorderBrush="{StaticResource BorderLight}" 
                         CaretBrush="#FFFFFF"
                         Padding="4,2" 
                         FontSize="12" 
                         VerticalContentAlignment="Center"
                         Margin="4,0"
                         KeyDown="OnReplaceKeyDown" />

                <Button Grid.Column="2" 
                        Style="{StaticResource ToolbarButtonStyle}" 
                        Content="Replace" 
                        Padding="6,2" 
                        Margin="2,0" 
                        FontSize="11" 
                        Click="OnReplaceClick" />

                <Button Grid.Column="3" 
                        Style="{StaticResource ToolbarButtonStyle}" 
                        Content="Replace All" 
                        Padding="6,2" 
                        Margin="2,0" 
                        FontSize="11" 
                        Click="OnReplaceAllClick" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>

