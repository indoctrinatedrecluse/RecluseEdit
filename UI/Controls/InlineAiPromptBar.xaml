<UserControl x:Class="RecluseEdit.UI.Controls.InlineAiPromptBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignWidth="520">
    <Border Background="{DynamicResource BgSecondary}" 
            BorderBrush="{DynamicResource BorderDark}" 
            BorderThickness="1" 
            CornerRadius="6" 
            Padding="10,8"
            Width="520">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="4" Opacity="0.45" />
        </Border.Effect>

        <StackPanel>
            <!-- Header Row -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✨" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock Text="AI Inline Generation" FontWeight="SemiBold" Foreground="{DynamicResource FgPrimary}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="TxtProviderBadge" 
                           Grid.Column="2" 
                           Text="AI Provider Ready" 
                           Foreground="{DynamicResource FgSecondary}" 
                           FontSize="10" 
                           VerticalAlignment="Center" 
                           Margin="0,0,8,0" />

                <Button Grid.Column="3" 
                        Style="{StaticResource TabCloseButtonStyle}" 
                        ToolTip="Close (Esc)" 
                        Click="OnCloseClick" />
            </Grid>

            <!-- Input Prompt Row -->
            <TextBox x:Name="TxtPrompt" 
                     Background="{DynamicResource BgTertiary}" 
                     Foreground="{DynamicResource FgPrimary}" 
                     BorderBrush="{DynamicResource BorderLight}" 
                     CaretBrush="#FFFFFF"
                     Padding="6,6" 
                     FontSize="12" 
                     AcceptsReturn="False"
                     TextWrapping="Wrap" 
                     MaxHeight="80" 
                     MinHeight="32" 
                     Margin="0,0,0,6"
                     PreviewKeyDown="OnPromptPreviewKeyDown" />

            <!-- Action & Status Row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar x:Name="PrgGenerating" IsIndeterminate="True" Width="14" Height="14" Margin="0,0,6,0" Visibility="Collapsed" />
                    <TextBlock x:Name="TxtStatus" 
                               Text="Type instruction and press Enter to generate" 
                               Foreground="{DynamicResource FgSecondary}" 
                               FontSize="11" 
                               VerticalAlignment="Center" 
                               TextTrimming="CharacterEllipsis" 
                               MaxWidth="260" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnStop" 
                            Content="⏹ Stop" 
                            Background="#E06C75" 
                            Foreground="White" 
                            BorderThickness="0" 
                            Padding="8,3" 
                            Margin="0,0,4,0" 
                            FontSize="11" 
                            Cursor="Hand" 
                            Visibility="Collapsed" 
                            Click="OnStopClick" />

                    <Button x:Name="BtnAccept" 
                            Content="✔ Accept (Ctrl+Enter)" 
                            Background="#98C379" 
                            Foreground="#1E1E1E" 
                            FontWeight="SemiBold" 
                            BorderThickness="0" 
                            Padding="8,3" 
                            Margin="0,0,4,0" 
                            FontSize="11" 
                            Cursor="Hand" 
                            Visibility="Collapsed" 
                            Click="OnAcceptClick" />

                    <Button x:Name="BtnDiscard" 
                            Content="✖ Discard (Esc)" 
                            Background="#3E3E42" 
                            Foreground="{DynamicResource FgPrimary}" 
                            BorderThickness="0" 
                            Padding="8,3" 
                            Margin="0,0,4,0" 
                            FontSize="11" 
                            Cursor="Hand" 
                            Visibility="Collapsed" 
                            Click="OnDiscardClick" />

                    <Button x:Name="BtnGenerate" 
                            Content="Generate ➤" 
                            Background="{DynamicResource AccentPrimary}" 
                            Foreground="White" 
                            FontWeight="SemiBold" 
                            BorderThickness="0" 
                            Padding="10,3" 
                            FontSize="11" 
                            Cursor="Hand" 
                            Click="OnGenerateClick" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>

