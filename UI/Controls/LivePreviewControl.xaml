<UserControl x:Class="RecluseEdit.UI.Controls.LivePreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#181818">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Control Bar -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#333333" BorderThickness="0,0,0,1">
            <Grid Margin="6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Viewport Presets -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🌐 Live Preview" Foreground="#38BDF8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>

                    <RadioButton x:Name="PresetResponsiveBtn" Content="100% Full" IsChecked="True" Style="{DynamicResource DeviceRadioStyle}" Click="OnPresetChanged" Tag="Full" ToolTip="Responsive Full Width (100%)"/>
                    <RadioButton x:Name="PresetMobileBtn" Content="📱 Mobile" Style="{DynamicResource DeviceRadioStyle}" Click="OnPresetChanged" Tag="375" ToolTip="Mobile Viewport (375px)"/>
                    <RadioButton x:Name="PresetTabletBtn" Content="📟 Tablet" Style="{DynamicResource DeviceRadioStyle}" Click="OnPresetChanged" Tag="768" ToolTip="Tablet Viewport (768px)"/>
                    <RadioButton x:Name="PresetDesktopBtn" Content="💻 Desktop" Style="{DynamicResource DeviceRadioStyle}" Click="OnPresetChanged" Tag="1200" ToolTip="Desktop Viewport (1200px)"/>
                </StackPanel>

                <!-- Center: URL / Document Pill -->
                <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="12" Margin="12,4" HorizontalAlignment="Center" Padding="12,3" BorderBrush="#3A3D41" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="#4EC9B0" Margin="0,0,6,0" ToolTip="Live Sync Active"/>
                        <TextBlock x:Name="DocTitleText" Text="index.html" Foreground="#CCCCCC" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                    </StackPanel>
                </Border>

                <!-- Right: Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RefreshBtn" Content="🔄" Click="OnRefreshClick" Style="{DynamicResource ToolbarIconBtnStyle}" ToolTip="Refresh Preview"/>
                    <Button x:Name="ExternalBrowserBtn" Content="↗" Click="OnExternalBrowserClick" Style="{DynamicResource ToolbarIconBtnStyle}" ToolTip="Open in Default Browser"/>
                    <Button x:Name="CloseBtn" Content="✕" Click="OnCloseClick" Style="{DynamicResource ToolbarIconBtnStyle}" ToolTip="Close Live Preview"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- WebView2 Host Area -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Background="#121212">
            <Grid x:Name="HostContainer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border x:Name="ViewportBorder" Background="#FFFFFF" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderBrush="#333333" BorderThickness="0">
                    <wv2:WebView2 x:Name="WebViewControl"/>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Fallback/Status Overlay -->
        <Border x:Name="StatusOverlay" Grid.Row="1" Background="#1E1E1E" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" CornerRadius="8" BorderBrush="#333333" BorderThickness="1">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="StatusMessageText" Text="Initializing Live Preview Engine..." Foreground="#D4D4D4" FontSize="13" TextAlignment="Center" Margin="0,0,0,12"/>
                <Button x:Name="StatusActionBtn" Content="Retry Initialization" Click="OnRetryInitClick" Style="{DynamicResource PrimaryBtnStyle}" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>

    <UserControl.Resources>
        <Style x:Key="DeviceRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#37373D"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D2D30"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarIconBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3E3E42"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#0E639C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1177BB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
</UserControl>

