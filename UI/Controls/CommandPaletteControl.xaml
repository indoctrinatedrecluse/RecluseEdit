<UserControl x:Class="RecluseEdit.UI.Controls.CommandPaletteControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:RecluseEdit.Core.Models"
             mc:Ignorable="d" 
             d:DesignHeight="350" d:DesignWidth="620">

    <UserControl.Resources>
        <Style x:Key="PaletteItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Margin="2,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#04395E" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2A2D2E" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#094771" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Palette Container -->
    <Border Background="#252526" 
            BorderBrush="#007ACC" 
            BorderThickness="1" 
            CornerRadius="8" 
            Width="620" 
            MaxHeight="420"
            Padding="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.6" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Search Input -->
            <Border Grid.Row="0" Background="#1E1E1E" BorderBrush="#3C3C3C" BorderThickness="1" CornerRadius="4" Padding="4,2" Margin="0,0,0,6">
                <Grid>
                    <TextBox x:Name="TxtSearch"
                             Background="Transparent"
                             Foreground="#D4D4D4"
                             CaretBrush="#007ACC"
                             BorderThickness="0"
                             FontSize="14"
                             FontFamily="Segoe UI, Cascadia Code"
                             Padding="6,4"
                             TextChanged="OnSearchTextChanged"
                             PreviewKeyDown="OnSearchPreviewKeyDown" />

                    <!-- Placeholder -->
                    <TextBlock x:Name="TxtPlaceholder" 
                               Text="Type a command or '>' to search commands, ':' to go to line, '?' for help..."
                               Foreground="#6E6E6E"
                               FontSize="13"
                               Margin="10,6,0,0"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Results List -->
            <ListBox x:Name="LstResults"
                     Grid.Row="1"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ItemContainerStyle="{StaticResource PaletteItemStyle}"
                     MouseDoubleClick="OnResultDoubleClick"
                     PreviewKeyDown="OnListPreviewKeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:CommandItem}">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Icon / Category Glyph -->
                            <TextBlock Grid.Column="0" 
                                       Text="{Binding Icon, FallbackValue='⚡'}" 
                                       FontSize="14" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,8,0" />

                            <!-- Title & Subtitle/Category -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" 
                                           Foreground="#E0E0E0" 
                                           FontSize="13" 
                                           FontWeight="Medium" 
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Description, FallbackValue=''}" 
                                           Foreground="#858585" 
                                           FontSize="11" 
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding Description, Converter={x:Null}}" />
                            </StackPanel>

                            <!-- Shortcut Badge -->
                            <Border Grid.Column="2" 
                                    Background="#333333" 
                                    CornerRadius="3" 
                                    Padding="6,2" 
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding InputGestureText, Converter={x:Null}}">
                                <TextBlock Text="{Binding InputGestureText}" 
                                           Foreground="#007ACC" 
                                           FontSize="11" 
                                           FontFamily="Consolas, Cascadia Code" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Bottom Hint -->
            <Border Grid.Row="2" BorderBrush="#333333" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="4,4,4,0">
                <DockPanel>
                    <TextBlock Text="Navigate: ↑↓  •  Select: Enter  •  Dismiss: Esc" 
                               Foreground="#757575" 
                               FontSize="11" />
                    <TextBlock x:Name="TxtModeHint"
                               Text="Command Mode"
                               Foreground="#007ACC"
                               FontSize="11"
                               HorizontalAlignment="Right" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
