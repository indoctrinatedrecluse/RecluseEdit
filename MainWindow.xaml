<Window x:Class="RecluseEdit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RecluseEdit"
        xmlns:controls="clr-namespace:RecluseEdit.UI.Controls"
        xmlns:models="clr-namespace:RecluseEdit.Core.Models"
        mc:Ignorable="d"
        Title="RecluseEdit - Web Application Editor" 
        Icon="pack://application:,,,/Assets/app.ico"
        Height="760" Width="1180"
        MinHeight="450" MinWidth="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimary}"
        Foreground="{StaticResource FgPrimary}">

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="N" Command="{x:Static local:MainWindow.NewFileCommand}" />
        <KeyBinding Modifiers="Control" Key="O" Command="{x:Static local:MainWindow.OpenFileCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="O" Command="{x:Static local:MainWindow.OpenFolderCommand}" />
        <KeyBinding Modifiers="Control" Key="S" Command="{x:Static local:MainWindow.SaveFileCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="S" Command="{x:Static local:MainWindow.SaveAsFileCommand}" />
        <KeyBinding Modifiers="Control" Key="W" Command="{x:Static local:MainWindow.CloseFileCommand}" />
        <KeyBinding Modifiers="Control" Key="B" Command="{x:Static local:MainWindow.ToggleSidebarCommand}" />
        <KeyBinding Modifiers="Control" Key="F" Command="{x:Static local:MainWindow.FindCommand}" />
        <KeyBinding Modifiers="Control" Key="H" Command="{x:Static local:MainWindow.ReplaceCommand}" />
        <KeyBinding Modifiers="Control+Alt" Key="A" Command="{x:Static local:MainWindow.ToggleAiChatCommand}" />
        <KeyBinding Modifiers="Control" Key="OemTilde" Command="{x:Static local:MainWindow.ToggleTerminalCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0. Menu -->
            <RowDefinition Height="Auto" /> <!-- 1. Toolbar -->
            <RowDefinition Height="Auto" /> <!-- 2. Tab Strip -->
            <RowDefinition Height="*" />    <!-- 3. Workspace / Editor Viewport -->
            <RowDefinition Height="Auto" /> <!-- 4. Status Bar -->
        </Grid.RowDefinitions>

        <!-- 0. Menu Bar -->
        <Menu Grid.Row="0" Background="{StaticResource BgTertiary}">
            <MenuItem Header="_File">
                <MenuItem Header="_New File" InputGestureText="Ctrl+N" Click="OnNewFileClick" />
                <MenuItem Header="_Open File..." InputGestureText="Ctrl+O" Click="OnOpenFileClick" />
                <MenuItem Header="Open _Folder..." InputGestureText="Ctrl+Shift+O" Click="OnOpenFolderClick" />
                <Separator Background="{StaticResource BorderDark}" />
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="OnSaveFileClick" />
                <MenuItem Header="Save _As..." InputGestureText="Ctrl+Shift+S" Click="OnSaveAsFileClick" />
                <MenuItem Header="Save A_ll" Click="OnSaveAllClick" />
                <Separator Background="{StaticResource BorderDark}" />
                <MenuItem Header="_Close Tab" InputGestureText="Ctrl+W" Click="OnCloseTabClick" />
                <MenuItem Header="Close _All Tabs" Click="OnCloseAllTabsClick" />
                <Separator Background="{StaticResource BorderDark}" />
                <MenuItem Header="E_xit" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Click="OnUndoClick" />
                <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Click="OnRedoClick" />
                <Separator Background="{StaticResource BorderDark}" />
                <MenuItem Header="Cu_t" InputGestureText="Ctrl+X" Click="OnCutClick" />
                <MenuItem Header="_Copy" InputGestureText="Ctrl+C" Click="OnCopyClick" />
                <MenuItem Header="_Paste" InputGestureText="Ctrl+V" Click="OnPasteClick" />
                <MenuItem Header="Select _All" InputGestureText="Ctrl+A" Click="OnSelectAllClick" />
                <Separator Background="{StaticResource BorderDark}" />
                <MenuItem Header="_Find..." InputGestureText="Ctrl+F" Click="OnFindClick" />
                <MenuItem Header="_Replace..." InputGestureText="Ctrl+H" Click="OnReplaceClick" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="MenuSidebar" Header="Toggle _Sidebar" InputGestureText="Ctrl+B" IsCheckable="True" IsChecked="True" Click="OnToggleSidebarClick" />
                <MenuItem x:Name="MenuRightPane" Header="Toggle _AI Chat" InputGestureText="Ctrl+Alt+A" IsCheckable="True" IsChecked="True" Click="OnToggleAiChatClick" />
                <MenuItem x:Name="MenuTerminal" Header="Toggle _Terminal" InputGestureText="Ctrl+`" IsCheckable="True" IsChecked="True" Click="OnToggleTerminalClick" />
                <MenuItem x:Name="MenuWordWrap" Header="Word _Wrap" IsCheckable="True" Click="OnToggleWordWrapClick" />
                <MenuItem x:Name="MenuLineNumbers" Header="_Line Numbers" IsCheckable="True" IsChecked="True" Click="OnToggleLineNumbersClick" />
            </MenuItem>
            <MenuItem Header="E_xtensions">
                <MenuItem Header="_Manage Extensions..." Click="OnManageExtensionsClick" />
                <MenuItem Header="Open Extensions _Folder" Click="OnOpenExtensionsFolderClick" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About RecluseEdit" Click="OnAboutClick" />
            </MenuItem>
        </Menu>

        <!-- 1. Quick Action Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1" Padding="6,4">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnToggleSidebar" Style="{StaticResource ToolbarButtonStyle}" Click="OnToggleSidebarClick" ToolTip="Toggle Sidebar (Ctrl+B)">
                    <TextBlock Text="☰ Explorer" />
                </Button>

                <Rectangle Width="1" Fill="{StaticResource BorderDark}" Margin="6,2" />

                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnNewFileClick" ToolTip="New File (Ctrl+N)">
                    <TextBlock Text="📄 New" />
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnOpenFileClick" ToolTip="Open File (Ctrl+O)">
                    <TextBlock Text="📄 Open File" />
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnOpenFolderClick" ToolTip="Open Project Folder (Ctrl+Shift+O)">
                    <TextBlock Text="📁 Open Folder" />
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnSaveFileClick" ToolTip="Save File (Ctrl+S)">
                    <TextBlock Text="💾 Save" />
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnSaveAllClick" ToolTip="Save All">
                    <TextBlock Text="💾 Save All" />
                </Button>

                <Rectangle Width="1" Fill="{StaticResource BorderDark}" Margin="6,2" />

                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnFindClick" ToolTip="Find (Ctrl+F)">
                    <TextBlock Text="🔍 Find" />
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnReplaceClick" ToolTip="Replace (Ctrl+H)">
                    <TextBlock Text="🔄 Replace" />
                </Button>

                <Rectangle Width="1" Fill="{StaticResource BorderDark}" Margin="6,2" />

                <Primitives:ToggleButton xmlns:Primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                                         x:Name="BtnWordWrap" 
                                         Content="Wrap" 
                                         ToolTip="Toggle Word Wrap"
                                         Padding="8,4" Margin="2,1"
                                         FontSize="12"
                                         Click="OnToolbarWordWrapClick" />

                <Primitives:ToggleButton xmlns:Primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                                         x:Name="BtnLineNumbers" 
                                         Content="123" 
                                         IsChecked="True"
                                         ToolTip="Toggle Line Numbers"
                                         Padding="8,4" Margin="2,1"
                                         FontSize="12"
                                         Click="OnToolbarLineNumbersClick" />

                <Primitives:ToggleButton xmlns:Primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                                         x:Name="BtnToggleAiChat" 
                                         Content="🤖 AI Chat" 
                                         IsChecked="True"
                                         ToolTip="Toggle DeepSeek AI Chat (Ctrl+Alt+A)"
                                         Padding="8,4" Margin="2,1"
                                         FontSize="12"
                                         Click="OnToggleAiChatClick" />

                <Primitives:ToggleButton xmlns:Primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                                         x:Name="BtnToggleTerminal" 
                                         Content="💻 Terminal" 
                                         IsChecked="True"
                                         ToolTip="Toggle Terminal (Ctrl+`)"
                                         Padding="8,4" Margin="2,1"
                                         FontSize="12"
                                         Click="OnToolbarTerminalClick" />

                <Rectangle Width="1" Fill="{StaticResource BorderDark}" Margin="6,2" />

                <TextBlock Text="Language:" VerticalAlignment="Center" Foreground="{StaticResource FgSecondary}" Margin="4,0,6,0" FontSize="12" />
                <ComboBox x:Name="CmbLanguage" 
                          Style="{StaticResource DarkComboBoxStyle}" 
                          Width="130"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="OnLanguageChanged" />
            </StackPanel>
        </Border>

        <!-- 2. Tab Strip -->
        <Border Grid.Row="2" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <ItemsControl x:Name="TabItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="TabBorder"
                                        Background="{StaticResource BgTertiary}" 
                                        BorderBrush="{StaticResource BorderDark}" 
                                        BorderThickness="0,0,1,0"
                                        Padding="12,7"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="OnTabClicked"
                                        MouseDown="OnTabMouseDown">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Close" Click="OnMenuCloseTabClick" />
                                            <MenuItem Header="Close Other Tabs" Click="OnMenuCloseOtherTabsClick" />
                                            <MenuItem Header="Close Tabs to the Right" Click="OnMenuCloseRightTabsClick" />
                                            <Separator Background="{StaticResource BorderDark}" />
                                            <MenuItem Header="Copy Full Path" Click="OnMenuCopyFullPathClick" />
                                            <MenuItem Header="Reveal in File Explorer" Click="OnMenuRevealInExplorerClick" />
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" 
                                                   Foreground="{StaticResource FgPrimary}" 
                                                   FontSize="12"
                                                   VerticalAlignment="Center" />
                                        <Button Style="{StaticResource TabCloseButtonStyle}" 
                                                ToolTip="Close Tab (Ctrl+W)"
                                                Click="OnCloseTabButtonClicked" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource BgPrimary}" />
                                        <Setter TargetName="TabBorder" Property="BorderThickness" Value="0,2,1,0" />
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBlue}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- New Tab Button -->
                    <Button Style="{StaticResource ToolbarButtonStyle}" 
                            Content="+" 
                            FontSize="15" 
                            FontWeight="SemiBold"
                            Padding="8,2" 
                            Margin="4,2"
                            ToolTip="New Document (Ctrl+N)" 
                            Click="OnNewFileClick" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 3. Workspace / Editor Viewport -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColSidebar" Width="240" MinWidth="140" />
                <ColumnDefinition x:Name="ColSplitter" Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ColRightSplitter" Width="Auto" />
                <ColumnDefinition x:Name="ColRightPane" Width="380" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- Left: Workspace Explorer Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header -->
                    <Border Grid.Row="0" Background="{StaticResource BgTertiary}" Padding="8,6" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="TxtWorkspaceName" Text="EXPLORER" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource FgSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                            <Button Grid.Column="1" Style="{StaticResource ToolbarButtonStyle}" Content="🔄" Width="22" Height="22" Padding="0" ToolTip="Refresh Workspace" Click="OnRefreshWorkspaceClick" />
                            <Button Grid.Column="2" Style="{StaticResource ToolbarButtonStyle}" Content="📁" Width="22" Height="22" Padding="0" ToolTip="Open Folder" Click="OnOpenFolderClick" />
                        </Grid>
                    </Border>

                    <!-- Sidebar File Tree -->
                    <TreeView x:Name="WorkspaceTreeView" Grid.Row="1" 
                              SelectedItemChanged="OnWorkspaceItemSelectionChanged"
                              MouseDoubleClick="OnWorkspaceTreeDoubleClick">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type models:FileSystemItem}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <TextBlock Text="{Binding Icon}" Margin="0,0,6,0" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- Splitter between Sidebar & Editor -->
            <GridSplitter x:Name="Splitter" Grid.Column="1" Style="{StaticResource VerticalSplitterStyle}" />

            <!-- Center: Editor & Terminal Area -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition x:Name="RowTerminalSplitter" Height="Auto" />
                    <RowDefinition x:Name="RowTerminalPane" Height="220" MinHeight="100" />
                </Grid.RowDefinitions>

                <!-- Top: Editor Host & Empty State -->
                <Grid Grid.Row="0">
                    <controls:EditorControl x:Name="EditorHost" Visibility="Visible" />

                    <!-- Empty State when no tabs are open -->
                    <Border x:Name="EmptyStateOverlay" Background="{StaticResource BgPrimary}" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="RecluseEdit" 
                                       FontSize="28" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource FgSecondary}" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,8" />
                            <TextBlock Text="Web Application Code Editor" 
                                       FontSize="14" 
                                       Foreground="{StaticResource FgMuted}" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,24" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource ToolbarButtonStyle}" 
                                        Content="Create New File (Ctrl+N)" 
                                        Padding="12,6" 
                                        Margin="4,0" 
                                        Click="OnNewFileClick" />
                                <Button Style="{StaticResource ToolbarButtonStyle}" 
                                        Content="Open File (Ctrl+O)" 
                                        Padding="12,6" 
                                        Margin="4,0" 
                                        Click="OnOpenFileClick" />
                                <Button Style="{StaticResource ToolbarButtonStyle}" 
                                        Content="Open Folder (Ctrl+Shift+O)" 
                                        Padding="12,6" 
                                        Margin="4,0" 
                                        Click="OnOpenFolderClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Horizontal Splitter between Editor and Terminal -->
                <GridSplitter x:Name="TerminalSplitter" Grid.Row="1" Style="{StaticResource HorizontalSplitterStyle}" />

                <!-- Bottom: Terminal Pane -->
                <controls:TerminalPaneControl x:Name="TerminalPane" Grid.Row="2" />
            </Grid>

            <!-- Splitter between Editor & Right Pane -->
            <GridSplitter x:Name="RightSplitter" Grid.Column="3" Style="{StaticResource VerticalSplitterStyle}" />

            <!-- Right: AI Chat / Side Panel Host -->
            <Border x:Name="RightPaneBorder" Grid.Column="4" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Right Pane Header -->
                    <Border Grid.Row="0" Background="{StaticResource BgTertiary}" Padding="10,6" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtRightPaneIcon" Text="🤖" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtRightPaneTitle" Text="AI CHAT" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource FgSecondary}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource ToolbarButtonStyle}" Content="✕" Width="22" Height="22" Padding="0" ToolTip="Close Panel (Ctrl+Alt+A)" Click="OnCloseRightPaneClick" />
                        </Grid>
                    </Border>

                    <!-- Host for active side panel view -->
                    <ContentControl x:Name="RightPaneHost" Grid.Row="1">
                        <Border Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🤖" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                <TextBlock Text="DeepSeek AI Assistant" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource FgPrimary}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock Text="Initializing AI Extension..." FontSize="12" Foreground="{StaticResource FgMuted}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </ContentControl>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Bottom Status Bar -->
        <StatusBar Grid.Row="4" Background="{StaticResource AccentBlue}" Foreground="{StaticResource FgAccent}" Padding="8,3">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <StatusBarItem Grid.Column="0">
                <TextBlock x:Name="StatusMessage" Text="Ready" FontSize="11" />
            </StatusBarItem>

            <StatusBarItem Grid.Column="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusCaret" Text="Ln 1, Col 1" FontSize="11" Margin="8,0" />
                    <TextBlock Text="|" Opacity="0.5" />
                    <TextBlock x:Name="StatusLength" Text="Length: 0" FontSize="11" Margin="8,0" />
                    <TextBlock Text="|" Opacity="0.5" />
                    <TextBlock x:Name="StatusLanguage" Text="HTML" FontSize="11" Margin="8,0" />
                    <TextBlock Text="|" Opacity="0.5" />
                    <TextBlock x:Name="StatusEncoding" Text="UTF-8" FontSize="11" Margin="8,0" />
                    <TextBlock Text="|" Opacity="0.5" />
                    <TextBlock x:Name="StatusExtensions" Text="Extensions: 1" FontSize="11" Margin="8,0" Cursor="Hand" MouseLeftButtonDown="OnManageExtensionsClick" ToolTip="Click to manage extensions" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
