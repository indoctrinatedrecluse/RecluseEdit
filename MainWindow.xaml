<Window x:Class="RecluseEdit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RecluseEdit"
        xmlns:controls="clr-namespace:RecluseEdit.UI.Controls"
        mc:Ignorable="d"
        Title="RecluseEdit - Web Application Editor" 
        Height="720" Width="1140"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimary}"
        Foreground="{StaticResource FgPrimary}">

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="N" Command="{x:Static local:MainWindow.NewFileCommand}" />
        <KeyBinding Modifiers="Control" Key="O" Command="{x:Static local:MainWindow.OpenFileCommand}" />
        <KeyBinding Modifiers="Control" Key="S" Command="{x:Static local:MainWindow.SaveFileCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="S" Command="{x:Static local:MainWindow.SaveAsFileCommand}" />
        <KeyBinding Modifiers="Control" Key="W" Command="{x:Static local:MainWindow.CloseFileCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Menu -->
            <RowDefinition Height="Auto" /> <!-- Toolbar -->
            <RowDefinition Height="Auto" /> <!-- Tab Strip -->
            <RowDefinition Height="*" />    <!-- Editor Viewport -->
            <RowDefinition Height="Auto" /> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 0. Menu Bar -->
        <Menu Grid.Row="0" Background="{StaticResource BgTertiary}">
            <MenuItem Header="_File">
                <MenuItem Header="_New File" InputGestureText="Ctrl+N" Click="OnNewFileClick" />
                <MenuItem Header="_Open File..." InputGestureText="Ctrl+O" Click="OnOpenFileClick" />
                <Separator Background="{StaticResource BorderDark}" />
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="OnSaveFileClick" />
                <MenuItem Header="Save _As..." InputGestureText="Ctrl+Shift+S" Click="OnSaveAsFileClick" />
                <MenuItem Header="Save A_ll" Click="OnSaveAllClick" />
                <Separator Background="{StaticResource BorderDark}" />
                <MenuItem Header="_Close Tab" InputGestureText="Ctrl+W" Click="OnCloseTabClick" />
                <Separator Background="{StaticResource BorderDark}" />
                <MenuItem Header="E_xit" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Click="OnUndoClick" />
                <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Click="OnRedoClick" />
                <Separator Background="{StaticResource BorderDark}" />
                <MenuItem Header="Cu_t" InputGestureText="Ctrl+X" Click="OnCutClick" />
                <MenuItem Header="_Copy" InputGestureText="Ctrl+C" Click="OnCopyClick" />
                <MenuItem Header="_Paste" InputGestureText="Ctrl+V" Click="OnPasteClick" />
                <MenuItem Header="Select _All" InputGestureText="Ctrl+A" Click="OnSelectAllClick" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="MenuWordWrap" Header="Word _Wrap" IsCheckable="True" Click="OnToggleWordWrapClick" />
                <MenuItem x:Name="MenuLineNumbers" Header="_Line Numbers" IsCheckable="True" IsChecked="True" Click="OnToggleLineNumbersClick" />
            </MenuItem>
            <MenuItem Header="E_xtensions">
                <MenuItem Header="View _Loaded Extensions" Click="OnViewExtensionsClick" />
                <MenuItem Header="Open Extensions _Folder" Click="OnOpenExtensionsFolderClick" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About RecluseEdit" Click="OnAboutClick" />
            </MenuItem>
        </Menu>

        <!-- 1. Quick Action Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1" Padding="6,4">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnNewFileClick" ToolTip="New File (Ctrl+N)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📄 New" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnOpenFileClick" ToolTip="Open File (Ctrl+O)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📂 Open" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnSaveFileClick" ToolTip="Save File (Ctrl+S)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💾 Save" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnSaveAllClick" ToolTip="Save All">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💾 Save All" />
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Fill="{StaticResource BorderDark}" Margin="8,2" />

                <ToggleButton x:Name="BtnWordWrap" 
                              Content="Wrap" 
                              ToolTip="Toggle Word Wrap"
                              Padding="8,4" Margin="2,1"
                              FontSize="12"
                              Click="OnToolbarWordWrapClick" />

                <ToggleButton x:Name="BtnLineNumbers" 
                              Content="123" 
                              IsChecked="True"
                              ToolTip="Toggle Line Numbers"
                              Padding="8,4" Margin="2,1"
                              FontSize="12"
                              Click="OnToolbarLineNumbersClick" />

                <Rectangle Width="1" Fill="{StaticResource BorderDark}" Margin="8,2" />

                <TextBlock Text="Language:" VerticalAlignment="Center" Foreground="{StaticResource FgSecondary}" Margin="4,0,6,0" FontSize="12" />
                <ComboBox x:Name="CmbLanguage" 
                          Style="{StaticResource DarkComboBoxStyle}" 
                          Width="130"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="OnLanguageChanged" />
            </StackPanel>
        </Border>

        <!-- 2. Tab Strip -->
        <Border Grid.Row="2" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <ItemsControl x:Name="TabItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="TabBorder"
                                        Background="{StaticResource BgTertiary}" 
                                        BorderBrush="{StaticResource BorderDark}" 
                                        BorderThickness="0,0,1,0"
                                        Padding="12,7"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="OnTabClicked">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" 
                                                   Foreground="{StaticResource FgPrimary}" 
                                                   FontSize="12"
                                                   VerticalAlignment="Center" />
                                        <Button Style="{StaticResource TabCloseButtonStyle}" 
                                                ToolTip="Close Tab (Ctrl+W)"
                                                Click="OnCloseTabButtonClicked" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=DataContext.IsActive}" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource BgPrimary}" />
                                        <Setter TargetName="TabBorder" Property="BorderThickness" Value="0,2,1,0" />
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBlue}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- New Tab Button -->
                    <Button Style="{StaticResource ToolbarButtonStyle}" 
                            Content="+" 
                            FontSize="15" 
                            FontWeight="SemiBold"
                            Padding="8,2" 
                            Margin="4,2"
                            ToolTip="New Document (Ctrl+N)" 
                            Click="OnNewFileClick" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 3. Editor Host Viewport -->
        <Grid Grid.Row="3">
            <controls:EditorControl x:Name="EditorHost" Visibility="Visible" />

            <!-- Empty State when no tabs are open -->
            <Border x:Name="EmptyStateOverlay" Background="{StaticResource BgPrimary}" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="RecluseEdit" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource FgSecondary}" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,8" />
                    <TextBlock Text="Web Application Code Editor" 
                               FontSize="14" 
                               Foreground="{StaticResource FgMuted}" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,24" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource ToolbarButtonStyle}" 
                                Content="Create New File (Ctrl+N)" 
                                Padding="12,6" 
                                Margin="4,0" 
                                Click="OnNewFileClick" />
                        <Button Style="{StaticResource ToolbarButtonStyle}" 
                                Content="Open File (Ctrl+O)" 
                                Padding="12,6" 
                                Margin="4,0" 
                                Click="OnOpenFileClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 4. Bottom Status Bar -->
        <StatusBar Grid.Row="4" Background="{StaticResource AccentBlue}" Foreground="{StaticResource FgAccent}" Padding="8,3">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <StatusBarItem Grid.Column="0">
                <TextBlock x:Name="StatusMessage" Text="Ready" FontSize="11" />
            </StatusBarItem>

            <StatusBarItem Grid.Column="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusCaret" Text="Ln 1, Col 1" FontSize="11" Margin="8,0" />
                    <TextBlock Text="|" Opacity="0.5" />
                    <TextBlock x:Name="StatusLength" Text="Length: 0" FontSize="11" Margin="8,0" />
                    <TextBlock Text="|" Opacity="0.5" />
                    <TextBlock x:Name="StatusLanguage" Text="HTML" FontSize="11" Margin="8,0" />
                    <TextBlock Text="|" Opacity="0.5" />
                    <TextBlock x:Name="StatusEncoding" Text="UTF-8" FontSize="11" Margin="8,0" />
                    <TextBlock Text="|" Opacity="0.5" />
                    <TextBlock x:Name="StatusExtensions" Text="Extensions: 1" FontSize="11" Margin="8,0" Cursor="Hand" MouseLeftButtonDown="OnViewExtensionsClick" ToolTip="Click to view loaded extensions" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
